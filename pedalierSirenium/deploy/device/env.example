# Configuration du pédalier — copiée vers ~/.config/pedalier/env au bootstrap,
# puis JAMAIS écrasée : une modification locale survit aux mises à jour (le
# script dépose ses nouveautés en env.new et signale la différence).
#
# Les units systemd lisent ce fichier ; après l'avoir modifié :
#   pedalier-ctl restart

# Dépôts sur la machine
PEDALIER_REPO=@HOME@/dev/src/mecaviv-qml-ui
PD_REPO=@HOME@/dev/src/mecaviv/puredata-abstractions

# Patch chargé par Pure Data (relatif à examples/)
PD_PATCH=pedalier.pd

# Binaire Pd. Repli en cas de problème avec le 0.55 compilé : /usr/bin/pd (0.53 Debian)
PEDALIER_PD_BIN=/usr/local/bin/pd

# Sortie audio de Pure Data. En JACK, Pd est un client de PipeWire : PipeWire
# tient le lien avec le casque Bluetooth et en absorbe la latence variable. En
# ALSA, Pd pilotait le PCM lui-meme et un a-coup au demarrage a froid le laissait
# boucler indefiniment sur `alsa xrun recovery apparently failed` -- boucle qui le
# monopolise et le coupe du WebSocket.
#
# `-noadc` parce qu'il n'y a pas d'entree audio et que Pd echoue sinon.
# run-pd.sh lance Pd sous pw-jack, qui met la libjack de PipeWire sur le chemin.
#
# Repli ALSA, si PipeWire manque : "-alsa -alsaadd default -noadc -audiooutdev default".
# Y designer la sortie par son NOM et pas par un index : run-pd.sh le traduit a
# chaque lancement, l'index de `default` dependant du nombre de cartes enumerees.
# Les guillemets sont obligatoires : ce fichier est aussi source comme un script
# shell par pedalier-ctl, et sans eux `-alsaadd` serait pris pour une commande.
PD_AUDIO_OPTS="-jack -noadc"

# Serveur web (l'application QML) et serveur WebSocket (tenu par Pd)
WEB_PORT=8010
WS_PORT=10000

KIOSK_URL=http://localhost:8010/qmlwebsocketserver.html

# Données runtime (clips, scènes, presets) — hors de tout arbre git
PEDALIER_DATA=@HOME@/pedalier-data
