[Unit]
Description=Pédalier — câblage des ports ALSA (rtpmidid → Pure Data)
PartOf=pedalier.target
After=pedalier-pd.service pedalier-rtpmidid.service

[Service]
Type=oneshot
# Pas de RemainAfterExit : le timer doit pouvoir rejouer le câblage. Les ports
# RTP n'apparaissent que lorsque la machine d'en face s'annonce sur le réseau —
# au démarrage à froid, elle n'est pas encore là, et un branchement peut arriver
# à n'importe quel moment ensuite.
EnvironmentFile=%h/.config/pedalier/env
ExecStart=@PEDALIER_REPO@/pedalierSirenium/scripts/rtpmidi_connect_async.sh
TimeoutStartSec=120

[Install]
WantedBy=pedalier.target
