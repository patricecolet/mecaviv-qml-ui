[Unit]
Description=Pédalier Sirenium — ensemble des services
# Cible unique pour tout démarrer, arrêter ou relancer d'un coup :
#   systemctl --user restart pedalier.target
Wants=pedalier-rtpmidid.service pedalier-pd.service pedalier-node.service pedalier-midi-connect.service

[Install]
WantedBy=default.target
