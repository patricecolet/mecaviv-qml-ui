[Unit]
Description=Pédalier — moteur Pure Data
PartOf=pedalier.target
After=pedalier-rtpmidid.service

[Service]
EnvironmentFile=%h/.config/pedalier/env
# Le répertoire de travail EST une dépendance : les `declare -path ../…` de
# pedalier.pd sont relatifs au dossier du patch.
WorkingDirectory=@PD_REPO@/examples
# Les sockets UDP vers les sirènes sont ouvertes une seule fois, au chargement
# du patch : démarrer avant que eth0 ait son adresse condamne la sortie V1 pour
# toute la session. Le script n'échoue jamais, il attend au plus 30 s.
ExecStartPre=@PEDALIER_REPO@/pedalierSirenium/deploy/device/wait-network.sh
# Meme raison, pour le son : Pd ouvre son PCM une fois et ne le rouvre jamais.
# Le casque Bluetooth met quelques secondes a etre joint au demarrage a froid.
ExecStartPre=@PEDALIER_REPO@/pedalierSirenium/deploy/device/wait-audio.sh
# PD_AUDIO_OPTS vient de ~/.config/pedalier/env, jamais ecrase par le deploiement :
# c'est un reglage de machine. Vide, Pd prend la premiere carte ALSA -- sur ce Pi
# c'est VirMIDI, qui n'est pas une sortie audio, donc rien ne s'entend.
# Le DSP est allume par le patch lui-meme (loadbang -> `; pd dsp 1`), pas ici :
# ainsi il l'est aussi quand on ouvre pedalier.pd a la main.
Environment=PD_BIN=@PD_BIN@
# run-pd.sh traduit `-audiooutdev default` en index : cet index depend du
# nombre de cartes ALSA enumerees, qui n'est pas le meme a froid et a chaud.
ExecStart=@PEDALIER_REPO@/pedalierSirenium/deploy/device/run-pd.sh @PD_PATCH@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=pedalier.target
