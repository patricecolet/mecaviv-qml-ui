<RCC>
    <qresource prefix="/">
        <!-- Main files -->
        <file>qml/qmlwebsocketserver/main.qml</file>
        <file>qml/qmlwebsocketserver/Settings.qml</file>

        <!-- Play components (refonte 2D) -->
        <file>qml/qmlwebsocketserver/components/play/Ring2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/ClockBar2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/FocusDial2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/SirenRingRow2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/ModeMark2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/SongMap2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/ChordCartouche2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/SireniumMonitor2D.qml</file>
        <file>qml/qmlwebsocketserver/components/play/SimulationHarness.qml</file>
        <file>qml/qmlwebsocketserver/components/play/LiveState.qml</file>

        <!-- Scene management (tactile) -->
        <file>qml/qmlwebsocketserver/components/scenes/SceneManager2D.qml</file>
        <file>qml/qmlwebsocketserver/components/scenes/TouchKeyboard2D.qml</file>

        <!-- Config components (refonte 2D) -->
        <file>qml/qmlwebsocketserver/components/config/PedalboardPortrait2D.qml</file>
        <file>qml/qmlwebsocketserver/components/config/ModulationMatrix2D.qml</file>
        <file>qml/qmlwebsocketserver/components/config/ConfigView2D.qml</file>
        <file>qml/qmlwebsocketserver/components/config/MaintenanceView2D.qml</file>

        <!-- Controllers -->
        <file>qml/qmlwebsocketserver/controllers/MessageParser.qml</file>
        <file>qml/qmlwebsocketserver/controllers/MidiMonitorController.qml</file>
        <file>qml/qmlwebsocketserver/controllers/WebSocketController.qml</file>

        <!-- Utils -->
        <file>qml/qmlwebsocketserver/utils/Logger.qml</file>
        <file>qml/qmlwebsocketserver/config.js</file>
        <file>qml/qmlwebsocketserver/sirenSpec.json</file>
        <file>qml/qmlwebsocketserver/sirenSpec.js</file>

    </qresource>

    <!-- Polices partagées -->
    <qresource prefix="/">
        <file>../../fonts/EmojiFont.qml</file>
        <file>../../fonts/NotoEmoji-VariableFont_wght.ttf</file>
    </qresource>
</RCC>
